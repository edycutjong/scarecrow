# ── Scarecrow — Environment Variables ────────────────────────
# This app runs 100% OFFLINE on a Raspberry Pi.
# No API keys required. All inference via @qvac/sdk.

# ── Sentry Configuration (Optional) ─────────────────────────
# Interval between sentry checks in milliseconds (default: 30000)
# SENTRY_INTERVAL_MS=30000

# ── Dashboard (Optional) ────────────────────────────────────
# Port for the local web dashboard (default: 8080)
# DASHBOARD_PORT=8080
